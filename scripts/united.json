    "columns": {
        "Farm Lot": {
            "source": "packing",
            "field": "lote_fundo"
        },
        "First Production Date": {
            "source": "packing",
            "field": "fecha_cosecha"
        },
        "Format": {
            "source": "transform",
            "transform": {
                "type": "conditional",
                "field": "presentacion",
                "source": "packing",
                "conditions": [
                    {
                        "contains": "3.5",
                        "result": "Bulk 3.5g"
                    },
                    {
                        "contains": "8x18",
                        "result": "8x18oz BK"
                    },
                    {
                        "contains": "11",
                        "result": "12x11oz"
                    },
                    {
                        "contains": "9.8",
                        "result": "12x9.8oz"
                    },
                    {
                        "contains": "12x18",
                        "result": "12x18oz"
                    },
                    {
                        "contains": "8x200",
                        "result": "8x200g"
                    },
                    {
                        "contains": "12x1",
                        "result": "12x1pint"
                    },
                    {
                        "contains": "12x16",
                        "result": "12x16oz"
                    },
                    {
                        "contains": "4.4",
                        "result": "12x4.4oz"
                    },
                    {
                        "contains": "6",
                        "result": "12x6oz"
                    }
                ],
                "default": "Bulk 3.5g"
            }
        },
        "Variety": {
            "source": "transform",
            "transform": {
                "type": "value_map",
                "field": "variedad",
                "source": "packing",
                "map": {
                    "EB 9-2": "09-02 Magica"
                },
                "default": null
            }
        },
        "Pallet number": {
            "source": "packing",
            "field": "id_pallet"
        },
        "Brand": {
            "source": "transform",
            "transform": {
                "type": "conditional",
                "field": "etiqueta_clamshell_tapa",
                "source": "packing",
                "conditions": [
                    {
                        "equals": "S/E",
                        "result": "No Label"
                    },
                    {
                        "contains": "organic",
                        "result": "OZblu Organic"
                    },
                    {
                        "contains": "ozblu",
                        "result": "OZblu"
                    },
                    {
                        "contains": "big bold",
                        "result": "Big Bold"
                    },
                    {
                        "contains": "heb",
                        "result": "HEB"
                    },
                    {
                        "contains": "china gold",
                        "result": "OZblu China Gold Jumbo"
                    },
                    {
                        "contains": "china",
                        "result": "OZblu China"
                    },
                    {
                        "contains": "jumbo",
                        "result": "OZblu Jumbo"
                    }
                ],
                "default": "No Label"
            }
        },
        "BLANK": {
            "source": "fijo",
            "value": ""
        },
        "Pallet Base": {
            "source": "transform",
            "transform": {
                "type": "conditional",
                "field": "tipo_pallet",
                "source": "packing",
                "conditions": [
                    {
                        "starts_with": "19",
                        "result": "Wood"
                    },
                    {
                        "starts_with": "16",
                        "result": "CHEP"
                    }
                ],
                "default": "CHEP"
            }
        },
        "Size": {
            "source": "transform",
            "transform": {
                "type": "value_map",
                "field": "calibre",
                "source": "packing",
                "map": {
                    "14+": "14mm",
                    "12+": "12mm",
                    "18+": "18mm",
                    "19+": "19mm"
                },
                "default": null
            }
        },
        "Class": {
            "source": "fijo",
            "value": "1"
        },
        "Inventory Code": {
            "source": "transform",
            "transform": {
                "type": "conditional",
                "field": "presentacion",
                "source": "packing",
                "conditions": [
                    {
                        "contains": "3.5",
                        "result": "BK (Bulk)"
                    }
                ],
                "default": "CS (Clamshell)"
            }
        },
        "Shipped via": {
            "source": "fijo",
            "value": "Sea Freight"
        },
        "Season": {
            "source": "fijo",
            "value": "2026 Blueberries PE"
        },
        "Cartons": {
            "source": "packing",
            "field": "total_cajas"
        },
        "Farm": {
            "source": "packing",
            "field": "fundo"
        },
        "Target Market": {
            "source": "packing",
            "field": "pais_destino"
        }
    },
    "date_columns": [
        "First Production Date"
    ]
}